End Class

' ── Typed sets ──────────────────────────────────────────────────────────────

' Properties every cloned member copies from the template.
Private Sub ClassicCopyFrame(source As UIControl, target As UIControl)
    target.Move(source.X, source.Y, source.Width, source.Height)
    target.Visible = source.Visible
    target.Enabled = source.Enabled
End Sub

''' A PushButton control set: `Action(index)`.
Public Class ClassicPushButtonSet Inherits ClassicControlSet
    Event Action(index As Integer)

    Public Sub Constructor(host As Window)
        Super.Constructor(host)
    End Sub

    Public Sub Constructor(host As View)
        Super.Constructor(host)
    End Sub

    ''' The member with this index, or Nil.
    Public Function Item(index As Integer) As ClassicPushButtonMember
        Dim m As ClassicControlSetMember = Me.MemberAt(index)
        If m = Nil Then Return Nil
        Return CType(m, ClassicPushButtonMember)
    End Function

    ''' Adds an already-placed button at an explicit index.
    Public Sub Register(member As ClassicPushButtonMember, index As Integer)
        Me.RegisterMember(member, index)
    End Sub

    ''' Places a new button at LastIndex + 1 and raises Open.
    Public Function Attach(member As ClassicPushButtonMember) As Integer
        Return Me.AttachMember(member, Nil)
    End Function

    ''' API 1 `New PushButton1`: a copy of the lowest-index member (frame,
    ''' Visible, Enabled, Caption) at LastIndex + 1. Default/Cancel are not
    ''' copied: a window has one default and one cancel button.
    Public Function NewMember() As ClassicPushButtonMember
        Dim template As ClassicPushButtonMember = CType(Me.TemplateMember(), ClassicPushButtonMember)
        Dim m As New ClassicPushButtonMember()
        ClassicCopyFrame(template, m)
        m.Caption = template.Caption
        Me.AttachMember(m, template)
        Return m
    End Function

    Protected Overrides Sub DispatchEvent(eventName As String, index As Integer)
        If eventName = "Action" Then RaiseEvent Action(index)
    End Sub
End Class

''' A CheckBox control set: `Action(index)`.
Public Class ClassicCheckBoxSet Inherits ClassicControlSet
    Event Action(index As Integer)

    Public Sub Constructor(host As Window)
        Super.Constructor(host)
    End Sub

    Public Sub Constructor(host As View)
        Super.Constructor(host)
    End Sub

    ''' The member with this index, or Nil.
    Public Function Item(index As Integer) As ClassicCheckBoxMember
        Dim m As ClassicControlSetMember = Me.MemberAt(index)
        If m = Nil Then Return Nil
        Return CType(m, ClassicCheckBoxMember)
    End Function

    ''' Adds an already-placed checkbox at an explicit index.
    Public Sub Register(member As ClassicCheckBoxMember, index As Integer)
        Me.RegisterMember(member, index)
    End Sub

    ''' Places a new checkbox at LastIndex + 1 and raises Open.
    Public Function Attach(member As ClassicCheckBoxMember) As Integer
        Return Me.AttachMember(member, Nil)
    End Function

    ''' API 1 `New CheckBox1`: copies frame, Visible, Enabled, Caption and
    ''' State from the lowest-index member. Setting the copied State raises
    ''' no Action: the member is not in the set yet.
    Public Function NewMember() As ClassicCheckBoxMember
        Dim template As ClassicCheckBoxMember = CType(Me.TemplateMember(), ClassicCheckBoxMember)
        Dim m As New ClassicCheckBoxMember()
        ClassicCopyFrame(template, m)
        m.Caption = template.Caption
        m.State = template.State
        Me.AttachMember(m, template)
        Return m
    End Function

    Protected Overrides Sub DispatchEvent(eventName As String, index As Integer)
        If eventName = "Action" Then RaiseEvent Action(index)
    End Sub
End Class

''' A TextField control set: `TextChange(index)`, `GotFocus(index)`,
''' `LostFocus(index)`.
Public Class ClassicTextFieldSet Inherits ClassicControlSet
    Event TextChange(index As Integer)
    Event GotFocus(index As Integer)
    Event LostFocus(index As Integer)

    Public Sub Constructor(host As Window)
        Super.Constructor(host)
    End Sub

    Public Sub Constructor(host As View)
        Super.Constructor(host)
    End Sub

    ''' The member with this index, or Nil.
    Public Function Item(index As Integer) As ClassicTextFieldMember
        Dim m As ClassicControlSetMember = Me.MemberAt(index)
        If m = Nil Then Return Nil
        Return CType(m, ClassicTextFieldMember)
    End Function

    ''' Adds an already-placed field at an explicit index.
    Public Sub Register(member As ClassicTextFieldMember, index As Integer)
        Me.RegisterMember(member, index)
    End Sub

    ''' Places a new field at LastIndex + 1 and raises Open.
    Public Function Attach(member As ClassicTextFieldMember) As Integer
        Return Me.AttachMember(member, Nil)
    End Function

    ''' API 1 `New TextField1`: copies frame, Visible, Enabled, Text,
    ''' Placeholder (API 1 CueText) and IsReadOnly (API 1 ReadOnly).
    Public Function NewMember() As ClassicTextFieldMember
        Dim template As ClassicTextFieldMember = CType(Me.TemplateMember(), ClassicTextFieldMember)
        Dim m As New ClassicTextFieldMember()
        ClassicCopyFrame(template, m)
        m.Text = template.Text
        m.Placeholder = template.Placeholder
        m.IsReadOnly = template.IsReadOnly
        Me.AttachMember(m, template)
        Return m
    End Function

    Protected Overrides Sub DispatchEvent(eventName As String, index As Integer)
        Select Case eventName
        Case "TextChange"
            RaiseEvent TextChange(index)
        Case "GotFocus"
            RaiseEvent GotFocus(index)
        Case "LostFocus"
            RaiseEvent LostFocus(index)
        End Select
    End Sub
End Class

''' A StaticText (Label) control set. Labels have no events.
Public Class ClassicLabelSet Inherits ClassicControlSet
    Public Sub Constructor(host As Window)
        Super.Constructor(host)
    End Sub

    Public Sub Constructor(host As View)
        Super.Constructor(host)
    End Sub

    ''' The member with this index, or Nil.
    Public Function Item(index As Integer) As ClassicLabelMember
        Dim m As ClassicControlSetMember = Me.MemberAt(index)
        If m = Nil Then Return Nil
        Return CType(m, ClassicLabelMember)
    End Function

    ''' Adds an already-placed label at an explicit index.
    Public Sub Register(member As ClassicLabelMember, index As Integer)
        Me.RegisterMember(member, index)
    End Sub

    ''' Places a new label at LastIndex + 1 and raises Open.
    Public Function Attach(member As ClassicLabelMember) As Integer
        Return Me.AttachMember(member, Nil)
    End Function

    ''' API 1 `New Label1`: copies frame, Visible, Enabled and Text.
    Public Function NewMember() As ClassicLabelMember
        Dim template As ClassicLabelMember = CType(Me.TemplateMember(), ClassicLabelMember)
        Dim m As New ClassicLabelMember()
        ClassicCopyFrame(template, m)
        m.Text = template.Text
        Me.AttachMember(m, template)
        Return m
    End Function
End Class

''' A Slider control set: `ValueChanged(index)`.
Public Class ClassicSliderSet Inherits ClassicControlSet
    Event ValueChanged(index As Integer)

    Public Sub Constructor(host As Window)
        Super.Constructor(host)
    End Sub

    Public Sub Constructor(host As View)
        Super.Constructor(host)
    End Sub

    ''' The member with this index, or Nil.
    Public Function Item(index As Integer) As ClassicSliderMember
        Dim m As ClassicControlSetMember = Me.MemberAt(index)
        If m = Nil Then Return Nil
        Return CType(m, ClassicSliderMember)
    End Function

    ''' Adds an already-placed slider at an explicit index.
    Public Sub Register(member As ClassicSliderMember, index As Integer)
        Me.RegisterMember(member, index)
    End Sub

    ''' Places a new slider at LastIndex + 1 and raises Open.
    Public Function Attach(member As ClassicSliderMember) As Integer
        Return Me.AttachMember(member, Nil)
    End Function

    ''' API 1 `New Slider1`: copies frame, Visible, Enabled, Minimum, Maximum
    ''' and Value. The copied Value is set before the member joins the set, so
    ''' it raises no ValueChanged.
    Public Function NewMember() As ClassicSliderMember
        Dim template As ClassicSliderMember = CType(Me.TemplateMember(), ClassicSliderMember)
        Dim m As New ClassicSliderMember()
        ClassicCopyFrame(template, m)
        m.Minimum = template.Minimum
        m.Maximum = template.Maximum
        m.Value = template.Value
        Me.AttachMember(m, template)
        Return m
    End Function

    Protected Overrides Sub DispatchEvent(eventName As String, index As Integer)
        If eventName = "ValueChanged" Then RaiseEvent ValueChanged(index)
    End Sub
End Class
