' API 1 system adapters. Foundation members come from the bundled legacy shim.
Import RBFoundation

''' Mode on a plain Timer reports the last RunMode/Enabled/Mode assignment.
''' It cannot observe native Start/Stop or automatic one-shot completion.
''' Use ClassicTimer when completion must update Mode (see notes/system.md).
Public Extension Function Mode(t As Timer) As Integer
    Return CType(t.RunMode, Integer)
End Function

Public Extension Sub Mode(t As Timer, Assigns value As Integer)
    If value < 0 Or value > 2 Then Throw New InvalidArgumentException("Timer.Mode must be ModeOff, ModeSingle, or ModeMultiple")
    t.RunMode = CType(value, TimerRunModes)
End Sub

Public Extension Shared Function Timer.ModeOff() As Integer
    Return 0
End Function

Public Extension Shared Function Timer.ModeSingle() As Integer
    Return 1
End Function

Public Extension Shared Function Timer.ModeMultiple() As Integer
    Return 2
End Function

''' Rewrite Timer declarations to ClassicTimer for observed one-shot completion.
''' Configure through Mode/RunMode/Enabled; direct Start/Stop bypass the shim.
Public Class ClassicTimer Inherits Timer
    Public Overrides Sub NotifyTick()
        If Me.Mode = Timer.ModeSingle Then Me.Mode = Timer.ModeOff
        Super.NotifyTick()
    End Sub
End Class

''' Most recent synchronous Execute status; native Shell remains persistent.
Public Extension Function ErrorCode(sh As Shell) As Integer
    Return sh.LastExitCode
End Function

' The getters already exist in legacyNet. Add only the missing Assigns forms.
Public Extension Sub RouterHops(socket As UDPSocket, Assigns value As Integer)
    If value < 0 Or value > 255 Then Throw New InvalidArgumentException("RouterHops must be in 0..255")
    socket.MulticastTTL = value
End Sub

Public Extension Sub SendToSelf(socket As UDPSocket, Assigns value As Boolean)
    socket.MulticastLoopback = value
End Sub

''' IPv4 API 1 Port/Connect facade. Inherited socket events are real native events.
''' Close is terminal in Buoy; create another instance to reconnect.
Public Class ClassicUDPSocket Inherits UDPSocket
    Private Property RequestedPort As Integer = 0

    Public Property Port As Integer
        Get
            If Me.IsBound Then Return Me.LocalPort
            Return Me.RequestedPort
        End Get
        Set
            If value < 0 Or value > 65535 Then Throw New InvalidArgumentException("UDP Port must be in 0..65535")
            If Me.IsBound Then Throw New InvalidArgumentException("Close and replace the UDP socket before changing its bound Port")
            Me.RequestedPort = value
        End Set
    End Property

    Public Property IsConnected As Boolean
        Get
            Return Me.IsBound
        End Get
    End Property

    Public Sub Connect()
        If Not Me.IsBound Then Me.Bind(Me.RequestedPort)
    End Sub

    ''' API 1 sends to this socket's Port, not the last peer's source port.
    Public Sub Write(address As String, data As String)
        Me.Connect()
        Super.Write(data, address, Me.Port)
    End Sub
End Class

#If TargetWindows Then
Private Declare Function ClassicLoadLibrary Lib "kernel32" Alias "LoadLibraryW" (name As Ptr) As Ptr
Private Declare Function ClassicFindSymbol Lib "kernel32" Alias "GetProcAddress" (handle As Ptr, name As String) As Ptr
#ElseIf TargetMac Then
Private Declare Function ClassicOpenLibrary Lib "c" Alias "dlopen" (name As String, loadFlags As Int32) As Ptr
Private Declare Function ClassicFindSymbol Lib "c" Alias "dlsym" (handle As Ptr, name As String) As Ptr
#Else
Private Declare Function ClassicOpenLibrary Lib "c" Alias "dlopen" (name As String, loadFlags As Int32) As Ptr
Private Declare Function ClassicFindSymbol Lib "c" Alias "dlsym" (handle As Ptr, name As String) As Ptr
#End If

Private Function ClassicHasNul(value As String) As Boolean
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    For i As Integer = 0 To encoded.Count - 1
        If encoded.Item(i) = 0 Then Return True
    Next
    Return False
End Function

' Successful handles remain loaded for process lifetime, as with Soft Declare.
Private Class ClassicLibraryCache
    Private Shared Property Lock As Mutex = New Mutex()
    Private Shared Property Handles As Map Of String, Ptr = New Map Of String, Ptr()

    Public Shared Function HasSymbol(functionName As String, libraryName As String) As Boolean
        If functionName = "" Or libraryName = "" Then Return False
        If ClassicHasNul(functionName) Or ClassicHasNul(libraryName) Then Return False
        SyncLock ClassicLibraryCache.Lock
            Dim found As Optional Of Ptr = ClassicLibraryCache.Handles.Get(libraryName)
            Dim handle As Ptr = Nil
            If found.HasValue Then
                handle = found.Value
            Else
                Dim nativeName As String = libraryName
                #If TargetWindows Then
                Dim wideName As Bytes = Bytes.FromString(nativeName, Text.Encodings.UTF16LE)
                wideName.Append(0)
                wideName.Append(0)
                handle = ClassicLoadLibrary(wideName.DataPtr())
                #ElseIf TargetMac Then
                If nativeName = "c" Or nativeName = "System" Then nativeName = "/usr/lib/libSystem.B.dylib"
                handle = ClassicOpenLibrary(nativeName, 1)
                #Else
                If nativeName = "c" Then nativeName = "libc.so.6"
                handle = ClassicOpenLibrary(nativeName, 1)
                #End If
                If handle = Nil Then Return False
                ClassicLibraryCache.Handles.Set(libraryName, handle)
            End If
            Return ClassicFindSymbol(handle, functionName) <> Nil
        End SyncLock
    End Function
End Class

''' Native exported-symbol lookup. Library paths/names follow the OS loader;
''' c is additionally accepted on Unix, System on macOS. No symbol invocation.
Public Extension Shared Function System.IsFunctionAvailable(functionName As String, libraryName As String) As Boolean
    Return ClassicLibraryCache.HasSymbol(functionName, libraryName)
End Function

' ProcessKit is an explicit dependency of the shell adapter, not another
' RBClassic module. It is already distributed separately in this repository.
Import ProcessKit

Private Class ClassicShellPollTimer Inherits Timer
    Public Property Owner As Weak ClassicShell

    Public Overrides Sub NotifyTick()
        Dim shell As ClassicShell = Me.Owner
        If shell = Nil Then
            Me.Stop()
        Else
            shell.Poll()
        End If
    End Sub
End Class

''' Independent incremental decoder for one pipe. Keep incomplete UTF-8 tails
''' until more bytes arrive; never interleave bytes from stdout and stderr.
Private Class ClassicShellDecoder
    Private Property Pending As Bytes = New Bytes()

    Public Function Decode(chunk As Bytes, atEnd As Boolean) As String
        Me.Pending.Append(chunk)
        Dim count As Integer = Me.Pending.Count
        For i As Integer = 0 To count - 1
            If Me.Pending.Item(i) = 0 Then Throw New EncodingException("ClassicShell text output cannot contain NUL")
        Next
        Dim complete As Integer = count
        If Not atEnd And count > 0 Then
            Dim first As Integer = count - 1
            While first >= 0
                Dim b As Integer = Me.Pending.Item(first)
                If b < 128 Or b > 191 Then Exit While
                first -= 1
            End While
            If first >= 0 Then
                Dim lead As Integer = Me.Pending.Item(first)
                Dim needed As Integer = 1
                If lead >= 194 And lead <= 223 Then needed = 2
                If lead >= 224 And lead <= 239 Then needed = 3
                If lead >= 240 And lead <= 244 Then needed = 4
                If count - first < needed Then complete = first
            End If
        End If
        Dim prefix As New Bytes()
        For i As Integer = 0 To complete - 1
            prefix.Append(Me.Pending.Item(i))
        Next
        ' The decoder validates complete sequences, including overlong and
        ' surrogate forms. An incomplete sequence at EOF is an explicit error.
        Dim text As String = prefix.ToString(Text.Encodings.UTF8)
        Dim remaining As New Bytes()
        For i As Integer = complete To count - 1
            remaining.Append(Me.Pending.Item(i))
        Next
        Me.Pending = remaining
        Return text
    End Function
End Class

''' Rewrite Shell to ClassicShell for per-Execute processes and API 1 modes.
''' UTF-8 pipes, no PTY; stdout/stderr ordering across pipes is not preserved.
''' Async events need the native event loop or explicit Poll calls.
Public Class ClassicShell
    Private Property CommandProcess As PipeProcess
    Private Property PollTimer As ClassicShellPollTimer
    Private Property ExecuteMode As Integer = 0
    Private Property Output As String = ""
    Private Property OutputDecoder As ClassicShellDecoder = New ClassicShellDecoder()
    Private Property ErrorDecoder As ClassicShellDecoder = New ClassicShellDecoder()
    Private Property Status As Integer = 0
    Private Property StartedAt As Integer = 0
    Private Property TimedOut As Boolean = False
    Private Property Polling As Boolean = False

    Public Event DataAvailable()
    Public Event Completed()

    Public Property Mode As Integer
        Get
            Return Me.ExecuteMode
        End Get
        Set
            If value < 0 Or value > 2 Then Throw New InvalidArgumentException("Shell.Mode must be 0, 1, or 2")
            If Me.CommandProcess <> Nil Then Throw New InvalidArgumentException("Cannot change Shell.Mode while a command is active")
            Me.ExecuteMode = value
        End Set
    End Property

    ''' Windows-only, as in API 1. -1 disables the timeout.
    Public Property TimeOut As Integer = 2000

    Public Property Result As String
        Get
            Return Me.Output
        End Get
    End Property

    Public Property ErrorCode As Integer
        Get
            Return Me.Status
        End Get
    End Property

    Public Property ExitCode As Integer
        Get
            Return Me.Status
        End Get
    End Property

    Public Property IsRunning As Boolean
        Get
            If Me.CommandProcess = Nil Then Return False
            Return Me.CommandProcess.IsRunning
        End Get
    End Property

    Public Sub Execute(command As String)
        If Me.CommandProcess <> Nil Then Throw New InvalidArgumentException("Close the current command before Execute")
        If ClassicHasNul(command) Then Throw New InvalidArgumentException("Shell command contains NUL")
        If Me.TimeOut < -1 Then Throw New InvalidArgumentException("Shell.TimeOut must be -1 or nonnegative")
        Me.Output = ""
        Me.OutputDecoder = New ClassicShellDecoder()
        Me.ErrorDecoder = New ClassicShellDecoder()
        Me.Status = 0
        Me.TimedOut = False
        Me.StartedAt = System.Microseconds()
        #If TargetWindows Then
        Dim shellPath As String = System.EnvironmentVariable("COMSPEC").Or("C:\\Windows\\System32\\cmd.exe")
        Me.CommandProcess = New PipeProcess(shellPath, ["/d", "/s", "/c", command], "", True)
        #Else
        Me.CommandProcess = New PipeProcess("/bin/sh", ["-c", command], "", True)
        #End If
        If Me.ExecuteMode <> 2 Then Me.CommandProcess.CloseInput()
        If Me.ExecuteMode = 0 Then
            While Me.CommandProcess <> Nil
                Me.Poll()
                If Me.CommandProcess <> Nil Then Thread.Sleep(1)
            End While
        Else
            Me.PollTimer = New ClassicShellPollTimer()
            Me.PollTimer.Owner = Me
            Me.PollTimer.Period = 10
            Me.PollTimer.Start()
        End If
    End Sub

    ''' Poll observes real process status and pipe EOF; it does not infer completion
    ''' from silence. Call on the main thread, like the native timer callback.
    Public Sub Poll()
        If Me.CommandProcess = Nil Or Me.Polling Then Return
        Me.Polling = True
        Dim added As Boolean = False
        Dim finished As Boolean = False
        Try
            #If TargetWindows Then
            If Me.TimeOut >= 0 And Not Me.TimedOut And Me.CommandProcess.IsRunning Then
                If System.Microseconds() - Me.StartedAt >= Me.TimeOut * 1000 Then
                    Me.TimedOut = True
                    Me.CommandProcess.TerminateTree()
                End If
            End If
            #End If
            Dim outputChunk As Bytes = Me.CommandProcess.ReadOutput()
            Dim errorChunk As Bytes = Me.CommandProcess.ReadError()
            Dim stdoutText As String = Me.OutputDecoder.Decode(outputChunk, Me.CommandProcess.OutputClosed)
            Dim stderrText As String = Me.ErrorDecoder.Decode(errorChunk, Me.CommandProcess.ErrorClosed)
            added = String.LenBytes(stdoutText) > 0 Or String.LenBytes(stderrText) > 0
            Me.Output += stdoutText + stderrText
            If Not Me.CommandProcess.Poll() Then
                If Me.CommandProcess.OutputClosed And Me.CommandProcess.ErrorClosed Then
                    Me.Status = Me.CommandProcess.ExitCode
                    If Me.TimedOut Then Me.Status = -2
                    Me.ReleaseProcess()
                    finished = True
                End If
            End If
        Catch e As Exception
            ' Restore the guard before rethrowing as well as in Finally: callers
            ' may recover from a decoding error and immediately Execute again.
            Me.Polling = False
            If Me.CommandProcess <> Nil Then Me.CommandProcess.TerminateTree()
            Me.ReleaseProcess()
            Throw e
        Finally
            Me.Polling = False
        End Try
        If Me.ExecuteMode <> 0 Then
            If added Then RaiseEvent DataAvailable()
            If finished Then RaiseEvent Completed()
        End If
    End Sub

    Public Function ReadAll() As String
        Dim contents As String = Me.Result
        Me.Output = ""
        Return contents
    End Function

    Public Sub Write(data As String)
        If Me.ExecuteMode <> 2 Or Me.CommandProcess = Nil Then Throw New InvalidArgumentException("Shell.Write requires a running Mode 2 command")
        Dim writing As PipeProcess = Me.CommandProcess
        Dim encoded As Bytes = Bytes.FromString(data, Text.Encodings.UTF8)
        Dim offset As Integer = 0
        While offset < encoded.Count
            offset += Me.CommandProcess.WriteInput(encoded, offset)
            ' Drain both output pipes while waiting for stdin backpressure.
            Me.Poll()
            If offset < encoded.Count And Not (Me.CommandProcess Is writing) Then Throw New InvalidArgumentException("Shell command changed during Write")
            If offset < encoded.Count Then Thread.Sleep(1)
        End While
    End Sub

    Public Sub WriteLine(data As String)
        Me.Write(data + String.Chr(10))
    End Sub

    Private Sub ReleaseProcess()
        If Me.PollTimer <> Nil Then Me.PollTimer.Stop()
        Me.PollTimer = Nil
        If Me.CommandProcess <> Nil Then Me.CommandProcess.Close()
        Me.CommandProcess = Nil
    End Sub

    Public Sub Close()
        If Me.CommandProcess = Nil Then Return
        Dim closing As PipeProcess = Me.CommandProcess
        closing.TerminateTree()
        While Me.CommandProcess Is closing
            Me.Poll()
            If Me.CommandProcess Is closing Then Thread.Sleep(1)
        End While
    End Sub

    Public Sub Destructor()
        ' Destructor teardown must not deliver callbacks into a dying object.
        If Me.CommandProcess <> Nil Then Me.CommandProcess.TerminateTree()
        Me.ReleaseProcess()
    End Sub
End Class


''' POSIX-only integer-priority overload of the API 1 argument order.
''' Accepts native syslog severities 0..7; no guessed legacy LogLevel constants.
''' Requires /usr/bin/logger. Windows needs a real Event Log adapter.
Public Extension Shared Sub System.Log(level As Integer, message As String)
    #If TargetWindows Then
    Throw New UnsupportedOperationException("Classic System.Log requires a Windows Event Log adapter")
    #Else
    If level < 0 Or level > 7 Then Throw New InvalidArgumentException("System.Log requires a POSIX syslog severity in 0..7")
    If ClassicHasNul(message) Then Throw New InvalidArgumentException("System.Log message contains NUL")
    Dim priorities As Array Of String = ["emerg", "alert", "crit", "err", "warning", "notice", "info", "debug"]
    Dim logger As New PipeProcess("/usr/bin/logger", ["-p", "user." + priorities(level), "--", message])
    Try
        logger.CloseInput()
        Dim diagnostics As New Bytes()
        While True
            logger.ReadOutput()
            diagnostics.Append(logger.ReadError())
            If Not logger.Poll() Then
                If logger.OutputClosed And logger.ErrorClosed Then Exit While
            End If
            Thread.Sleep(1)
        End While
        If logger.ExitCode <> 0 Then Throw New Exception("System logger failed: " + diagnostics.ToString(Text.Encodings.UTF8))
    Finally
        logger.Close()
    End Try
    #End If
End Sub
