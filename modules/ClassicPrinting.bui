Import RBFoundation
' ClassicPrinting — REALbasic / legacy API 1 printing adapters.
'
' API 1 `OpenPrinter`/`OpenPrinterDialog` return a printer-backed `Graphics`
' that paginates with `NextPage` and is sent to the printer when it goes out
' of scope. Buoy has no printer `Graphics`, so this module records every page
' as vector PDF through the bundled `pdf` package (`PDFGraphics Implements
' IGraphics`) and hands the finished document to a native print system:
'
'   API 1 source                         rewrite
'   Dim p As New PrinterSetup        ->  Dim p As New ClassicPrinterSetup
'   Dim g As Graphics = OpenPrinter(p) -> Dim g As ClassicPrinterGraphics = OpenPrinter(p)
'   g = OpenPrinterDialog(p, w)      ->  g = OpenPrinterDialog(p, w)
'   g.NextPage                       ->  g.NextPage()
'
' Destinations (see notes/printing.md for the exact tested boundary):
'   * PDF (all platforms): `ClassicOpenPDFPrinter(setup)` records the same
'     pages without contacting any print system; `ClassicFinishPrinting`
'     then exposes the bytes. It is never reported as a physical job.
'   * Linux CUPS: `OpenPrinter` streams the PDF to the setup's named queue,
'     or the default queue, through libcups (`libcups.so.2`).
'   * Linux GTK 4: `OpenPrinterDialog` runs the native GtkPrintUnixDialog and
'     sends the PDF to the selected GtkPrinter with GtkPrintJob.
'   * macOS/Windows printer destinations raise UnsupportedOperationException.
'
' Global functions need a selective import to be callable unqualified:
'   Public Import ClassicPrinting.{ OpenPrinter, OpenPrinterDialog, ClassicOpenPDFPrinter }

Import PDF
Import ClassicGraphics

' ── Validation helpers ──────────────────────────────────────────────────────

Internal Sub ClassicPrintRequireText(value As String, name As String, allowEmpty As Boolean)
    If Not allowEmpty And value = "" Then
        Throw New InvalidArgumentException(name + " must not be empty")
    End If
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    If encoded.Count > 4096 Then
        Throw New InvalidArgumentException(name + " exceeds 4096 bytes")
    End If
    For i As Integer = 0 To encoded.Count - 1
        If encoded.Item(i) = 0 Then
            Throw New InvalidArgumentException(name + " cannot contain NUL")
        End If
    Next
End Sub

' Base14/TrueType text is written through libharu's single-byte encoding, so
' only printable ASCII is accepted rather than emitting wrong glyphs.
Internal Sub ClassicPrintRequireDrawableText(value As String)
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    For i As Integer = 0 To encoded.Count - 1
        Dim b As Integer = encoded.Item(i)
        If b < 32 Or b > 126 Then
            Throw New UnsupportedOperationException("printer text supports printable ASCII only; byte " + RBFoundation.Str(b) + " at offset " + RBFoundation.Str(i))
        End If
    Next
End Sub

Internal Sub ClassicPrintRequirePoints(value As Double, name As String, low As Double, high As Double)
    If Not (value >= low And value <= high) Then
        Throw New InvalidArgumentException(name + " must be within " + RBFoundation.Str(low) + "-" + RBFoundation.Str(high) + " points")
    End If
End Sub

Internal Sub ClassicPrintRequireResolution(value As Integer, name As String)
    If value = -1 Then
        Throw New UnsupportedOperationException(name + " = -1 (device maximum) is unsupported: the vector backends report no driver resolution; request an explicit dpi")
    End If
    If value < 1 Or value > 9600 Then Throw New InvalidArgumentException(name + " must be within 1-9600")
End Sub

' Rejects NaN, infinities and coordinates beyond any page (|v| > 1e9).
Internal Sub ClassicPrintRequireFinite(values As Array Of Double)
    For Each v As Double In values
        If Not (v >= -1000000000.0 And v <= 1000000000.0) Then
            Throw New InvalidArgumentException("Drawing coordinates and sizes must be finite")
        End If
    Next
End Sub

Internal Function ClassicPrintRound3(value As Double) As Double
    Return Math.Round(value * 1000.0) / 1000.0
End Function

' ── pdf package library ─────────────────────────────────────────────────────
' pdf 2.4.6 PDFGraphics.FillPath/StrokePath set the color after the path is
' built, which libharu rejects (HPDF_PAGE_INVALID_GMODE, 0x1051); see
' upstream-issues/classic-wave2-printing. Polygons therefore paint through
' the same exported libpdf symbols the package binds, with the fill color
' set before the path. HPDF_REAL arguments go through its bui_pdf_* shims.
Private Declare Function ClassicPDFAddPage Lib "pdf" Alias "HPDF_AddPage" (document As Ptr) As Ptr
Private Declare Function ClassicPDFSetWidth Lib "pdf" Alias "bui_pdf_page_set_width" (page As Ptr, value As Double) As Integer
Private Declare Function ClassicPDFSetHeight Lib "pdf" Alias "bui_pdf_page_set_height" (page As Ptr, value As Double) As Integer
Private Declare Function ClassicPDFSetFill Lib "pdf" Alias "bui_pdf_page_set_rgb_fill" (page As Ptr, r As Double, g As Double, b As Double) As Integer
Private Declare Function ClassicPDFMoveTo Lib "pdf" Alias "bui_pdf_page_move_to" (page As Ptr, x As Double, y As Double) As Integer
Private Declare Function ClassicPDFLineTo Lib "pdf" Alias "bui_pdf_page_line_to" (page As Ptr, x As Double, y As Double) As Integer
Private Declare Function ClassicPDFClosePath Lib "pdf" Alias "HPDF_Page_ClosePath" (page As Ptr) As Integer
Private Declare Function ClassicPDFFill Lib "pdf" Alias "HPDF_Page_Fill" (page As Ptr) As Integer

' ── Linux native bindings ───────────────────────────────────────────────────

