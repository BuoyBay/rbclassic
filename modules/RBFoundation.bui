    Return XojoCore.Acos(value)
End Function

Public Function Atan(value As Double) As Double
    Return XojoCore.Atan(value)
End Function

Public Function Atan2(y As Double, x As Double) As Double
    Return XojoCore.Atan2(y, x)
End Function

Public Function Sign(value As Double) As Integer
    Return XojoCore.Sign(value)
End Function

Public Function Min(v1 As Double, v2 As Double, ParamArray rest As Double) As Double
    Dim extreme As Double = Math.Min(v1, v2)
    For Each value As Double In rest
        extreme = Math.Min(extreme, value)
    Next
    Return extreme
End Function

Public Function Max(v1 As Double, v2 As Double, ParamArray rest As Double) As Double
    Dim extreme As Double = Math.Max(v1, v2)
    For Each value As Double In rest
        extreme = Math.Max(extreme, value)
    Next
    Return extreme
End Function

Public Function Rnd() As Double
    Return XojoCore.Rnd()
End Function

Public Function Microseconds() As Integer
    Return XojoCore.Microseconds()
