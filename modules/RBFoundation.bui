' External compatibility boundary: the toolchain ships this package as Xojo.
' Keep that import literal; RBClassic owns all authored package/module names.
' Forwarded globals retain the installed compatibility semantics, not native equivalence.
Public Import Xojo

Public Function CDbl(s As String) As Double
    Return XojoCore.CDbl(s)
End Function

Public Function Chr(value As Integer) As String
    Return XojoCore.Chr(value)
End Function

Public Function Hex(n As Integer) As String
    Return XojoCore.Hex(n)
End Function

Public Function Oct(n As Integer) As String
    Return XojoCore.Oct(n)
End Function

Public Function Bin(n As Integer) As String
    Return XojoCore.Bin(n)
End Function

Public Function Abs(value As Double) As Double
    Return XojoCore.Abs(value)
End Function

Public Function Abs(value As Integer) As Integer
    Return XojoCore.Abs(value)
End Function

Public Function Round(value As Double) As Double
    Return XojoCore.Round(value)
End Function

