    Private Optional Declare Sub WinReadCallRet Lib "kernel32" Alias "RtlMoveMemory" (ByRef target As ClassicWinCallRet, source As Ptr, length As Integer)
    Private Optional Declare Sub WinWriteMessage Lib "kernel32" Alias "RtlMoveMemory" (target As Ptr, ByRef source As ClassicWinMsg, length As Integer)
