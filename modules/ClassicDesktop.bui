    ' Win32 MSG (48 bytes on 64-bit Windows).
    Sequential Structure ClassicWinMsg
        Window As Ptr
        Message As UInt32
        Padding As UInt32
        WParam As Int64
        LParam As Int64
        Time As UInt32
        PointX As Int32
        PointY As Int32
        Extra As UInt32
    End Structure

    ' EM_GETSEL's two DWORD out-parameters, read back from one 8-byte buffer.
    Sequential Structure ClassicWinSelection
        StartPos As UInt32
        EndPos As UInt32
    End Structure

    ' Win32 CWPRETSTRUCT (40 bytes on 64-bit Windows).
    Sequential Structure ClassicWinCallRet
        Result As Int64
        LParam As Int64
        WParam As Int64
        Message As UInt32
        Padding As UInt32
        Window As Ptr
    End Structure

    ' Win32 COMBOBOXINFO (64 bytes on 64-bit Windows).
    Sequential Structure ClassicWinComboInfo
        Size As UInt32
        ItemLeft As Int32
        ItemTop As Int32
        ItemRight As Int32
        ItemBottom As Int32
        ButtonLeft As Int32
        ButtonTop As Int32
        ButtonRight As Int32
        ButtonBottom As Int32
        ButtonState As UInt32
        Combo As Ptr
        Item As Ptr
        List As Ptr
    End Structure

